    Component {
      Type          CScript
      Name          "LLG V1"
      Show          on
      Position      [735, 285]
      Direction     up
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         "[0 22 1920 1009]"
