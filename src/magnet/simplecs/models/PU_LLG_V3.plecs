      }
      Parameter {
        Variable      "Parameters"
        Value         "Ms, alpha, gamma, mu0, Hani_z, Hani_y, f_ani, H0"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"\n"
"#define PI 3.14159265358979323846\n"
"\n"
"#define IDX_MX 0\n"
"#define IDX_MY 1\n"
"#define IDX_MZ 2\n"
"\n"
"// Parameter order: Ms, alpha, gamma, mu0, Hani_z, Hani_y, f_ani, H0\n"
"#define Ms      ParamRealData(0,0)\n"
"#define alpha   ParamRealData(1,0)\n"
"#define gamma   ParamRealData(2,0)\n"
"#define mu0     ParamRealData(3,0)\n"
"#define Hani_zP ParamRealData(4,0)\n"
"#define Hani_yP ParamRealData(5,0)\n"
"#define f_ani   ParamRealData(6,0)\n"
"#define H0      ParamRealData(7,0)\n"
"\n"
"static void cross3(const double a[3], const double b[3], double c[3])\n"
"{\n"
"    c[0] = a[1]*b[2] - a[2]*b[1];\n"
"    c[1] = a[2]*b[0] - a[0]*b[2];\n"
"    c[2] = a[0]*b[1] - a[1]*b[0];\n"
"}\n"
"\n"
"static double clamp(double x, double lo, double hi)\n"
"{\n"
"    return (x < lo) ? lo : (x > hi) ? hi : x;\n"
"}\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "\n"
"ContState(IDX_MX) = 0;\n"
"ContState(IDX_MY) = 0;\n"
"ContState(IDX_MZ) = Ms;\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         base64 "CmRvdWJsZSBIX2FwcF96ID0gSW5wdXRTaWduYWwoMCwwKTsK"
"CmRvdWJsZSBNeiA9IENvbnRTdGF0ZShJRFhfTVopOwpkb3VibGUgQnogPSBtdTAgKiAoSF9hcHBfe"
"iArIE16KTsgICAvLyBvciBtdTAqKEhfZWZmX3ogKyBNeikgaWYgdGhhdOKAmXMgeW91ciBpbnRlbn"
"QKCmRvdWJsZSBNeCA9IENvbnRTdGF0ZShJRFhfTVgpOwpkb3VibGUgTXkgPSBDb250U3RhdGUoSUR"
"YX01ZKTsKCmRvdWJsZSBNbWFnID0gc3FydChNeCpNeCArIE15Kk15ICsgTXoqTXopICsgMWUtMTI7"
"CmRvdWJsZSBtel9ub3JtID0gTXogLyBNbWFnOwoKT3V0cHV0U2lnbmFsKDAsMCkgPSBIX2FwcF96O"
"wpPdXRwdXRTaWduYWwoMCwxKSA9IEJ6OwpPdXRwdXRTaWduYWwoMCwyKSA9IG16X25vcm07Cg=="
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         "\n"
"double H_app_z = InputSignal(0,0);\n"
"\n"
"double Ms_eff = fmax(fabs(Ms), 1e-12);\n"
"\n"
"// ---- Magnetization ----\n"
"double Mx = ContState(IDX_MX);\n"
"double My = ContState(IDX_MY);\n"
"double Mz = ContState(IDX_MZ);\n"
"\n"
"double Mmag = sqrt(Mx*Mx + My*My + Mz*Mz) + 1e-12;\n"
"double mz = Mz / Mmag;\n"
"\n"
"// ---- Uniaxial anisotropy ----\n"
"double H_ani_x = 0.0;\n"
"double H_ani_y = 0.0;\n"
"double H_ani_z = Hani_zP * mz;\n"
"\n"
"double H_eff[3];\n"
"H_eff[0] = H_ani_x;\n"
"H_eff[1] = Hani_yP + H_ani_y;\n"
"H_eff[2] = H_app_z + H_ani_z;\n"
"\n"
"// ---- LLG ----\n"
"double M[3] = { Mx, My, Mz };\n"
"double MxH[3], MxMxH[3];\n"
"\n"
"cross3(M, H_eff, MxH);\n"
"cross3(M, MxH, MxMxH);\n"
"\n"
"double a = alpha;\n"
"double pref = -gamma * mu0 / (1.0 + a*a);\n"
"double c1 = pref;\n"
"double c2 = pref * (a / Ms_eff);\n"
"\n"
"ContDeriv(IDX_MX) = c1*MxH[0] + c2*MxMxH[0];\n"
"ContDeriv(IDX_MY) = c1*MxH[1] + c2*MxMxH[1];\n"
"ContDeriv(IDX_MZ) = c1*MxH[2] + c2*MxMxH[2];\n"
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
